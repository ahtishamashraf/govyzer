# ---------------------------------------------------------------------------
# Govyzer API. Copy to .env for local development; set the same keys as Vercel
# project environment variables in a deployment. Never commit real values.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_ENV=local                 # local | preview | staging | production
PORT=4000
LOG_LEVEL=info

# --- Database (MySQL 8 / AWS RDS) ------------------------------------------
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=govyzer
DATABASE_PASSWORD=change-me
DATABASE_NAME=govyzer_dev
DATABASE_SSL=false            # must be true in production
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA=              # paste the RDS CA bundle (\n escaped) when pinning
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=4           # keep small: every warm serverless instance holds a pool
DATABASE_ACQUIRE_TIMEOUT_MS=15000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_DEBUG=false

# --- Crypto and sessions ---------------------------------------------------
# Versioned AES-256-GCM keys: v1:<base64 32 bytes>[,v2:<base64 32 bytes>]
# Generate with: node -e "console.log('v1:'+require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY=v1
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_COOKIE_DOMAIN=        # e.g. .govyzer.app to share cookies across subdomains
COOKIE_SECURE=false           # must be true in production

# --- Public URLs and CORS --------------------------------------------------
API_PUBLIC_URL=http://localhost:4000
CRM_PUBLIC_URL=http://localhost:3000
SALES_SCREEN_PUBLIC_URL=http://localhost:3100
ROOT_DOMAIN=localhost         # tenant subdomains under this domain are allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100

# --- Internal service auth and cron ----------------------------------------
INTERNAL_API_TOKEN=change-me-16-chars-min
CRON_SECRET=change-me-16-chars-min

# --- AWS S3 ----------------------------------------------------------------
S3_REGION=me-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=                  # only for S3-compatible storage
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SECONDS=900
S3_MAX_UPLOAD_BYTES=52428800

# --- Email -----------------------------------------------------------------
MAIL_DRIVER=log               # log | smtp
MAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=               # leave empty to run with AI disabled
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=1200
AI_ENABLED=true

# --- Messaging providers ---------------------------------------------------
WHATSYNCS_BASE_URL=
WHATSYNCS_API_KEY=
WHATSYNCS_WEBHOOK_SECRET=
WHATSAPP_CLOUD_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- OAuth providers -------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Optional realtime provider (polling works without it) ------------------
REALTIME_PROVIDER=none        # none | ably | pusher
REALTIME_KEY=

# --- Observability and limits ----------------------------------------------
SENTRY_DSN=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=20

# --- Sales Screen ----------------------------------------------------------
DISPLAY_PAIRING_CODE_TTL_SECONDS=600
DISPLAY_SESSION_TTL_DAYS=180
DISPLAY_FEED_POLL_SECONDS=12
